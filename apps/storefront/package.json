{
  "name": "@rad/storefront",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H localhost -p 3000",
    "build": "next build --webpack",
    "start": "next start -H localhost -p 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --experimental-test-module-mocks --test lib/api/*.spec.ts lib/artworks/*.spec.ts lib/catalog/*.spec.ts lib/payment/*.spec.ts features/home/const/*.spec.ts features/cart/*.spec.ts features/product-detail/*.spec.ts features/product-detail/transition/*.spec.ts features/studio/custom-designer/*.spec.ts components/account/*.spec.ts components/checkout/checkout-page/*.spec.ts components/checkout/checkout-payment/*.spec.ts lib/geo/*.spec.ts lib/phone/*.spec.ts app/api/revalidate-catalog/*.spec.ts app/*.spec.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "@rad/artworks": "1.5.1",
    "@rad/i18n": "1.5.1",
    "@rad/types": "1.5.1",
    "@rad/ui": "1.5.1",
    "lucide-react": "^1.33.0",
    "motion": "^14.1.0",
    "next": "16.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "postcss-custom-media": "^12.0.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.5",
    "typescript": "^5.8",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
