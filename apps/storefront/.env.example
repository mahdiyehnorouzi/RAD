# Used during `npm run build:vinext` so /backend rewrites point at production API.
API_URL=https://api.rad-object.com
# Catalog data: auto (API, falling back to the bundled registry), api (no fallback) or registry (offline).
CATALOG_SOURCE=auto

# Same value as apps/api's SEAWEEDFS_PUBLIC_URL (only needed when that
# provider is in use). Read at build/start time, never bundled as-is: it
# lets next.config.mjs allowlist the SeaweedFS host in images.remotePatterns
# and lets product-media.tsx route SeaweedFS-hosted photos through Next's
# own image optimizer instead of shipping unresized originals at thumbnail
# size. Safe to leave unset — SeaweedFS images just keep their previous
# unresized passthrough behavior.
# SEAWEEDFS_PUBLIC_URL=https://api.rad-object.com/storage/rad-public

NEXT_PUBLIC_SITE_URL=https://www.rad-object.com

# GA4 measurement ID from Admin > Data streams (format G-XXXXXXXXXX). Empty disables analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Required for `npm run deploy:cloudflare` (create at https://dash.cloudflare.com/profile/api-tokens)
# Permissions: Account / Workers Scripts / Edit, Account / Workers KV Storage / Edit (if using cache)
CLOUDFLARE_API_TOKEN=

# Shared secret that POST /api/revalidate-catalog checks on the
# x-revalidate-secret header. apps/api's matching CATALOG_REVALIDATE_SECRET
# must hold the exact same value — Admin uses it to tell this app its
# catalog cache is stale right after a product write, instead of waiting
# out the 30s (5s for an empty result) cache window. Leaving this unset
# disables the route (503) with no other effect: the time-based cache
# expiry is still there as a fallback.
CATALOG_REVALIDATE_SECRET=
