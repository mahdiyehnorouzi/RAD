# Environment variables for the storefront on Liara (Docker platform).
#
# Runtime vars (set these in the Liara app's "متغیرهای محیطی" / Environment
# Variables panel, or `liara env:set` — read fresh by the Node process on
# every request, no rebuild needed to change them):
API_URL=https://api.rad-object.com
CATALOG_SOURCE=auto
# Opt-in only: turns on the dev-only proxy/client timing diagnostics in
# production temporarily. Leave unset normally.
# RAD_PROXY_TIMING=1

# Build-time vars (NEXT_PUBLIC_* are inlined into the client bundle at build
# time — they do NOT work as runtime-only env vars. Set these via
# liara.json's `build.args`, or pass `--build-arg` on `liara deploy`;
# changing one requires a rebuild+redeploy, not just an env change):
NEXT_PUBLIC_SITE_URL=https://rad-object.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
