{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "0a3200bf24b2133ce04ecb49452a036e",
  "main": "vinext/server/fetch-handler",
  "name": "rad-studio",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "rad-object.com", "custom_domain": true },
    { "pattern": "www.rad-object.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": { "enabled": true },
  "vars": {
    "API_URL": "https://rad-api-web-production-9b7c.up.railway.app",
    "RAD_VERSION": "1.2.0"
  }
}
