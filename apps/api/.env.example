DATABASE_URL="postgresql://rad:rad@localhost:5432/rad?schema=public"
# Schema sync defaults to on in development and off when NODE_ENV=production.
# Set explicitly to override (false for remote DBs where synchronize is slow/unreliable).
# TYPEORM_SYNCHRONIZE=false
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
# Behind nginx on the VPS: HOST=127.0.0.1 and TRUST_PROXY=1 so rate limits see the client IP.
# HOST=127.0.0.1
# TRUST_PROXY=1
STOREFRONT_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3002"
# Production:
# STOREFRONT_ORIGIN="https://rad-object.com"
# ADMIN_ORIGIN="https://admin.rad-object.com"
# Extra exact origins allowed by CORS, comma-separated (no wildcards).
# CORS_ORIGINS="https://staging.rad-object.com"
ADMIN_EMAIL="mahdiyeh.norozi77@gmail.com"
ADMIN_PASSWORD="change-me"
# EDITOR_EMAIL="sahar@rad.studio"
# EDITOR_PASSWORD="change-me"
OPENAI_API_KEY=

# Payment: manual_card (temporary bank-card transfer) or gateway (ZarinPal).
# Never set PAYMENT_MODE=gateway in production unless a live ZarinPal round
# trip has been confirmed. Copying the card number does not mark an order paid.
# PAYMENT_CARD_NUMBER is a dummy example — never commit a live PAN.
# PAYMENT_CARD_HOLDER must be the name printed on the physical card, not a brand alias.
PAYMENT_MODE="manual_card"
PAYMENT_CARD_NUMBER="6219861903364882"
PAYMENT_CARD_HOLDER="مهدیه نروزی"
PAYMENT_CARD_BANK=""

# Email (required for password recovery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="RAD Studio <your-email@gmail.com>"

# Cloudinary: direct-to-Cloudinary admin product image uploads (Phase 2,
# signed-upload flow). Required only for new image uploads from the admin
# dashboard — existing legacy_base64/static/external images keep working
# without these. CLOUDINARY_API_SECRET must never be exposed to any
# frontend (storefront or admin) — it only ever lives here, used server-side
# to sign upload params and to delete orphaned assets. CLOUDINARY_CLOUD_NAME
# is technically public-safe (Cloudinary URLs embed it) but is kept
# API-only too: every delivery URL is built server-side in
# `apps/api/src/catalog/product.mapper.ts`, so no frontend needs it either.
# CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
# CLOUDINARY_API_KEY="your-cloudinary-api-key"
# CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Video bytes are sent directly to Cloudinary; supported range >0–100 MiB.
PRODUCT_VIDEO_MAX_MB=50

# Media storage provider switch: "cloudinary" (default) or "seaweedfs".
# Leave unset to keep using Cloudinary above.
# MEDIA_STORAGE_PROVIDER="cloudinary"

# SeaweedFS: self-hosted S3-compatible adapter, used only when
# MEDIA_STORAGE_PROVIDER=seaweedfs. Secrets only ever live here, same as
# the Cloudinary block above — never exposed to any frontend.
#
# Values below are the REAL production topology (verified on the VPS, not
# assumed): the S3 gateway listens on loopback :8333, and
# api.rad-object.com/storage is an EXISTING nginx proxy in front of it
# (CORS preflight already confirmed working there) — reused as-is per "do
# not introduce a new media domain". The bucket nginx actually routes is
# `rad-public`, NOT `rad-media` (an earlier placeholder guess in this file
# that never matched the real bucket — corrected here).
# SEAWEEDFS_ENDPOINT="http://127.0.0.1:8333"
# SEAWEEDFS_BUCKET="rad-public"
# SEAWEEDFS_ACCESS_KEY="your-seaweedfs-access-key"
# SEAWEEDFS_SECRET_KEY="your-seaweedfs-secret-key"
# SEAWEEDFS_REGION="us-east-1"
#
# Delivery base: product.mapper.ts's seaweedfsDeliveryUrl() uses this
# verbatim (it does NOT append SEAWEEDFS_BUCKET again), so the bucket must
# be in the path here already — matching how nginx actually routes
# `/storage/<bucket>/...` to the gateway.
# SEAWEEDFS_PUBLIC_URL="https://api.rad-object.com/storage/rad-public"
#
# Upload base: the *browser* POSTs here directly for a signed upload.
# Unlike SEAWEEDFS_PUBLIC_URL above, do NOT include the bucket — the
# presigned POST's own path already ends in "/<bucket>" (path-style S3),
# and seaweedfs-storage.service.ts's publicUploadUrl() appends that path
# to whatever base is given here, so including the bucket twice would
# produce a wrong, double-bucketed upload URL.
# SEAWEEDFS_PUBLIC_UPLOAD_URL="https://api.rad-object.com/storage"
#
# After any Admin product write (publish/edit/sell/delete), tells the
# storefront's catalog cache it's stale — see catalog-revalidation.service.ts.
# STOREFRONT_REVALIDATE_URL must be the real public storefront origin
# (https://www.rad-object.com/api/revalidate-catalog), not an internal
# service address — the storefront terminates this route itself, there is
# no internal/private hostname for it in this deployment. Leaving either
# var unset makes notifyChanged() a no-op (logged, never throws); the
# storefront's own time-based cache expiry is the fallback either way.
# STOREFRONT_REVALIDATE_URL="https://www.rad-object.com/api/revalidate-catalog"
# CATALOG_REVALIDATE_SECRET="" # must exactly match the storefront's value
#
# SMS OTP sign-in (POST /auth/otp/request, /auth/otp/verify, /auth/otp/signin).
# Delivery uses Melipayamak's shared service-number template API so the
# code can reach numbers on the national telecom blacklist:
#   POST https://rest.payamak-panel.com/api/SendSMS/BaseServiceNumber
#   application/x-www-form-urlencoded
#   username, password, text, to, bodyId
# RAD generates the 6-digit code, stores only its hash, and sends that
# code as `text` — the approved template's only variable, with no extra
# semicolon-separated fields. A send counts only when RetStatus is 1 and
# StrRetStatus is exactly "OK". Value is the receipt id, never the OTP.
# Codes expire after 3 minutes; verification enforces that on the server.
#
# Before this works, register and get approval in the Melipayamak panel
# for a shared-number template whose single variable is the OTP. Put that
# approved template id in MELIPAYAMAK_BASE_SERVICE_BODY_ID. Do not put a
# guessed id here. MELIPAYAMAK_SENDER is not read by OTP delivery.
# Authentication stays the account username and password. Provider error
# 110 means the panel wants an API key instead; this client does not
# switch to one automatically.
# A missing username/password fails with melipayamak_not_configured. A
# missing or non-numeric template id fails with
# melipayamak_template_not_configured. Nothing else in the API is affected.
# Do not put real credentials in this file.
# MELIPAYAMAK_USERNAME=""
# MELIPAYAMAK_PASSWORD=""
# MELIPAYAMAK_BASE_SERVICE_BODY_ID="" # approved shared-number template id
#
# Generic SMS sending (MelipayamakConsoleService), via Melipayamak's
# Console "send/simple" REST API
# (https://console.melipayamak.com/api/send/simple/{TOKEN}) — a different
# Melipayamak product/account from the OTP template API above, with its own
# token-based auth. Deliberately NOT wired into OTP sign-in or order
# notifications yet (see MelipayamakConsoleService's own docstring).
# Leaving either var unset makes every send fail with a coded 500
# (melipayamak_console_not_configured); nothing else in the API is
# affected.
# MELIPAYAMAK_CONSOLE_API_TOKEN=""
# MELIPAYAMAK_CONSOLE_SENDER="" # the approved sender line number for this account
#
# Google Sign-In (auth/google-auth.service.ts). All three must be set
# together or the feature stays off (GET /auth/google then 400s with
# code "google_not_configured") — the rest of the API is unaffected either
# way. From Google Cloud Console > APIs & Services > Credentials > OAuth
# client ID (type "Web application"):
#  - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: from that client.
#    GOOGLE_CLIENT_SECRET must never be exposed to any frontend — it only
#    ever lives here, used server-side for the authorization-code exchange.
#  - Authorized redirect URI (set in the Console, must match exactly):
#    GOOGLE_CALLBACK_URL itself. IMPORTANT: this must be the STOREFRONT's
#    own origin + "/backend/auth/google/callback", never the API's own
#    domain directly — the storefront's existing app/backend/[...path]
#    proxy is what makes the session cookie Set-Cookie land on the
#    storefront's domain (what every other /backend/* call reads), not on
#    the API's separate domain where the browser would never send it back.
#    Same reasoning for the "Continue with Google" link itself
#    (account-login.tsx): it points at /backend/auth/google, not the API
#    directly.
#  - Authorized JavaScript origin: STOREFRONT_ORIGIN above.
#  - OAuth consent screen: scopes openid, email, profile only.
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# GOOGLE_CALLBACK_URL="http://localhost:3000/backend/auth/google/callback"
# Production:
# GOOGLE_CALLBACK_URL="https://www.rad-object.com/backend/auth/google/callback"
