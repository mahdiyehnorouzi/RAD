{
  "name": "@rad/api",
  "version": "1.5.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "predev": "node -e \"require('node:fs').existsSync('dist/main.js')||process.exit(1)\" || npm run build",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:production": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/sync-schema.ts && tsx seed/seed.ts",
    "db:ensure-staff": "tsx seed/ensure-staff.ts",
    "db:recover-admin-password": "tsx seed/recover-admin-password.ts",
    "db:import-uploaded-products": "tsx seed/import-uploaded-products.ts",
    "db:embedded": "node scripts/start-pg.mjs",
    "pricing:crawl": "tsx src/pricing/cli.ts",
    "test": "npm run test:pricing && npm run test:purchase && npm run test:catalog && npm run test:compression && npm run test:inventory && npm run test:database && npm run test:health && npm run test:deploy && npm run test:collaboration && npm run test:media && npm run test:mail && npm run test:seed && npm run test:auth",
    "test:media": "tsx --test src/storage/*.spec.ts src/database/safe-target.spec.ts src/admin/sign-auth.spec.ts src/admin/replace-images.spec.ts src/admin/orphan-upload.spec.ts",
    "test:pricing": "tsx --test src/pricing/*.spec.ts",
    "test:collaboration": "tsx --test src/artist-applications/*.spec.ts",
    "test:purchase": "tsx --test src/orders/*.spec.ts",
    "test:catalog": "tsx --test src/catalog/*.spec.ts",
    "test:compression": "tsx --test src/compression.spec.ts",
    "test:inventory": "tsx --test src/inventory/*.spec.ts",
    "test:database": "tsx --test src/database/*.spec.ts",
    "test:health": "tsx --test src/health/*.spec.ts",
    "test:deploy": "tsx --test scripts/*.spec.ts",
    "test:mail": "tsx --test src/mail/*.spec.ts",
    "test:seed": "tsx --test seed/*.spec.ts",
    "test:auth": "tsx --test src/auth/*.spec.ts src/admin/invite-member.spec.ts",
    "pricing:baseline": "tsx scripts/apply-baseline-prices.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^12.0.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.20.5",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@rad/artworks": "1.5.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.1.0-beta.12",
    "typescript": "^5.8"
  }
}
