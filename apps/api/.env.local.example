# Local-machine override, loaded BEFORE `.env` and taking precedence over it
# (see `app.module.ts`). Gitignored — never committed, never shared.
#
# Use this file instead of editing `.env` when your own `.env` is configured
# to point at a remote/shared database (e.g. for occasionally debugging
# against real data) and you want `npm run dev:api` to default to the local
# Docker Postgres (`npm run db:up`) instead.
#
# Copy this file to `.env.local` and nothing else — the values below already
# match `docker-compose.yml` and `database/data-source.ts`'s own
# `DEFAULT_DATABASE_URL`.
DATABASE_URL="postgresql://rad:rad@localhost:5432/rad"
TYPEORM_SYNCHRONIZE=true
