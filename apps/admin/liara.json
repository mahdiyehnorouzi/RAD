{
  "app": "rad-admin",
  "platform": "docker",
  "port": 3000,
  "build": {
    "dockerfile": "apps/admin/Dockerfile"
  },
  "healthCheck": {
    "command": "CMD node -e \"require('http').get('http://localhost:3000/api/health',(r)=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))\"",
    "interval": 30,
    "timeout": 15,
    "retries": 2,
    "startPeriod": 10
  }
}
