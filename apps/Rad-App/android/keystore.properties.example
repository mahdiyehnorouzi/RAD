# Copy to android/keystore.properties (gitignored) and fill in your upload key.
# Generate one with:
#   keytool -genkeypair -v -storetype PKCS12 -keystore rad-upload.keystore \
#     -alias rad-upload -keyalg RSA -keysize 2048 -validity 10000
# Paths are relative to android/app.
RAD_UPLOAD_STORE_FILE=rad-upload.keystore
RAD_UPLOAD_STORE_PASSWORD=
RAD_UPLOAD_KEY_ALIAS=rad-upload
RAD_UPLOAD_KEY_PASSWORD=
