{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "services/**/*.ts"],
  "exclude": ["node_modules", "apps"]
}
