{
  "name": "rad-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rad/storefront",
    "build": "npm run build --workspace @rad/storefront",
    "build:cloudflare": "npm run build:vinext --workspace @rad/storefront",
    "start": "npm run start --workspace @rad/storefront",
    "typecheck": "npm run typecheck --workspace @rad/storefront",
    "dev:vinext": "npm run dev:vinext --workspace @rad/storefront",
    "build:vinext": "npm run build:vinext --workspace @rad/storefront",
    "start:vinext": "npm run start:vinext --workspace @rad/storefront",
    "deploy:storefront": "bash scripts/deploy-storefront-cloudflare.sh",
    "deploy:vinext": "npm run deploy:cloudflare --workspace @rad/storefront",
    "dev:api": "npm run dev --workspace @rad/api",
    "setup:api": "docker compose up -d --wait && npm run setup --workspace @rad/api",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "dev:admin": "npm run dev --workspace @rad/admin",
    "build:admin": "npm run build --workspace @rad/admin",
    "build:admin:cloudflare": "npm run build:vinext --workspace @rad/admin",
    "deploy:admin": "npm run deploy:vinext --workspace @rad/admin",
    "deploy:api": "bash scripts/deploy-api-railway.sh",
    "deploy:api:render": "echo 'Connect render.yaml in the Render dashboard, then set admin API_URL to the Render service URL.'",
    "build:all": "npm run build --workspaces --if-present",
    "typecheck:all": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
