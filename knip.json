{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/storefront": {
      "entry": ["proxy.ts", "vite.config.ts"],
      "project": ["**/*.{ts,tsx,mjs}"],
      "ignore": [
        "dist/**",
        "public/**",
        "components/layout/chrome/pwa.tsx",
        "components/orders/**",
        "components/contact/**",
        "components/help/**"
      ]
